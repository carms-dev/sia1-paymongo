# Copy these settings into your private .env. Do not commit .env.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
PGSSL=true
PGSSL_CA=certs/supabase-prod-ca.crt
# For hosts without a certificate file, use PGSSL_CA_BASE64 instead of PGSSL_CA.
PG_POOL_MAX=3

PORT=3000
PRODUCT_SERVICE_URL=http://127.0.0.1:3001
ORDER_SERVICE_URL=http://127.0.0.1:3002
PAYMENT_SERVICE_URL=http://127.0.0.1:3003
APP_URL=http://localhost:3000

INTERNAL_API_KEY=replace_with_a_long_random_value
PAYMONGO_SECRET_KEY=sk_test_replace_me
PAYMONGO_WEBHOOK_SECRET=whsk_test_replace_me
PAYMONGO_PAYMENT_METHODS=card,gcash,qrph
